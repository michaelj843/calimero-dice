# Pick at most one target; with none, the page talks to the node that serves it.
# A local dev node (mock attestation, dev only):
# VITE_NODE_URL=http://127.0.0.1:2501
# A Calimero Cloud cluster by name:
# VITE_CLUSTER=eu-shared-1

# The package the instances were installed from (meroctl app pack --package).
# VITE_PACKAGE=com.example.dice
# Oldest mero-tee release to trust.
# VITE_MIN_RELEASE=2.3.109
